{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tramontana",
  "version": "0.1.0",
  "identifier": "app.tramontana.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @tramontana/desktop dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @tramontana/desktop build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tramontana",
        "width": 1280,
        "height": 832,
        "minWidth": 880,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Portable, policy-governed operating layer for AI work.",
    "copyright": "Copyright (c) 2026 Gašper Lotrič. MIT licensed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    }
  }
}
