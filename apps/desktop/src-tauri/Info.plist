<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Dictation (ADR 0065): asked only when the person presses the
       microphone. The recording is transcribed on this computer and not
       kept. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Tramontana uses the microphone only while you dictate. Your speech is turned into text on this computer and is not kept or sent anywhere.</string>
</dict>
</plist>
